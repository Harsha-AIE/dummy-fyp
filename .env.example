EDUKG_OPENAI_API_KEY=sk-...
EDUKG_NEO4J_URI=bolt://localhost:7687
EDUKG_NEO4J_USER=neo4j
EDUKG_NEO4J_PASSWORD=changeme

# Azure OpenAI — used for ontology extension proposals (pipeline stage 4)
# and entity-linking embeddings (stage 7). Without these, both features
# fail with ExternalServiceError; everything else still works.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=...

# Neon-hosted Postgres — durable storage for uploaded source documents and
# Knowledge Tracing events/mastery. Without this, uploads and Knowledge
# Tracing persistence fail; the KG pipeline and agents still work.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated allowed CORS origins for the FastAPI app. Defaults to
# http://localhost:3000,http://localhost:3001 if unset.
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
